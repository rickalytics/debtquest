# Copy to .env.ios.local. Native builds require an explicit mode.
VITE_DATA_MODE=local
# To use the EXISTING cloud project, set mode=cloud and both PUBLIC values below.
# Never put a Supabase service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# A support inbox you control. Required by the release readiness check.
VITE_SUPPORT_EMAIL=
